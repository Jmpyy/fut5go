# ==============================================================================
# FUT5GO - Global Environment Variables (Template)
# Copiar este archivo a .env y configurar los valores correspondientes
# ==============================================================================

# General
NODE_ENV=development
APP_NAME=fut5go

# Database (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fut5go_db
DB_USER=fut5go_admin
DB_PASSWORD=secret_password

# Backend Server
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Integrations / Third-Party
MERCADOPAGO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_TOKEN=
